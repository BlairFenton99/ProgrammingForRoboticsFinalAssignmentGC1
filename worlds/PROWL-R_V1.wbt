  title "PROWL-R Infiltration"
}
Viewpoint {
  orientation -0.5588167212284731 0.5830858941529885 0.5896903527405454 2.0384099858815126
  position 0 0 4.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}

RectangleArena {
  floorSize 2.0 0.8
  wallHeight 0.05
}

# Short wall hiding the flag from direct frontal view
# Centred at y=0 between Raiders' approach lanes and the flag.
# 0.28 m wide leaves ~0.26 m gaps to the arena walls on each side.
Solid {
  translation 0.73 0 0.035
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.35 0.35 0.35
        }
      }
      geometry Box {
        size 0.02 0.28 0.07
      }
    }
  ]
  name "flag_wall"
  boundingObject Box {
    size 0.02 0.28 0.07
  }
}

# Red flag — Raiders' objective (east end, centre)
