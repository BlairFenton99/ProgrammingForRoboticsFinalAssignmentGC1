#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  title "PROWL-R CTF — Defender Test"
}
Viewpoint {
  orientation -0.5588167212284731 0.5830858941529885 0.5896903527405454 2.0384099858815126
  position 0 0 3.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}

# Small isolated arena for testing defender patrol + obstacle avoidance
RectangleArena {
  floorSize 0.4 0.8
  wallHeight 0.05
}

# Orange obstacle on the patrol path — forces sideways avoidance to test RETURN_TO_PATROL
Solid {
  translation 0 0.2 0.04
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0.5 0
        }
      }
      geometry Box {
        size 0.12 0.06 0.08
      }
    }
  ]
  name "obstacle"
  boundingObject Box {
    size 0.12 0.06 0.08
  }
}

# Defender — centre of arena, facing north, compass enabled
E-puck {
  name "team_a_defender"
  translation 0 0 0
  rotation 0 0 1 1.5708
  controller "defender_controller"
  turretSlot [
    Compass {
    }
  ]
}
