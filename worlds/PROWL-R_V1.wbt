# Small isolated arena for testing the defender north-south bounce
RectangleArena {
  floorSize 0.4 0.8
  wallHeight 0.05
}

# Test defender — centre of arena, facing north (+y = rotation 90° around z)
E-puck {
  name "test_defender"
  translation 0 0 0
  rotation 0 0 1 1.5708
  controller "defender_test_controller"
}
